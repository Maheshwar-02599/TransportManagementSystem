@model TransportationManagement.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create User";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-user-plus me-2"></i>Create New User</h3>
    <a asp-action="Users" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="CreateUser" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Email (Username)</label>
                    <input asp-for="Username" class="form-control" placeholder="user@example.com" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
    
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Re-enter password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="">-- Select Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="FleetManager">Fleet Manager</option>
                        @* <option value="Driver">Driver</option> *@
                        <option value="MaintenanceEngineer">Maintenance Engineer</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
            </div>
            <button type="submit" class="btn btn-dark"><i class="fas fa-save me-1"></i>Create User</button>
            <a asp-action="Users" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
