@model TransportationManagement.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Create User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="fas fa-user-plus text-primary me-2"></i>Create New User</h3>
    <a asp-action="Users" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <form asp-action="CreateUser" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 rounded-3 border-0"></div>
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small text-uppercase">Email (Username)</label>
                    <input asp-for="Username" class="form-control bg-light border-0 rounded-3 py-2" placeholder="name@example.com" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small text-uppercase">Role</label>
                    <select asp-for="Role" class="form-select bg-light border-0 rounded-3 py-2">
                        <option value="">-- Select Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="FleetManager">Fleet Manager</option>
                        @* <option value="Driver">Driver</option> *@
                        <option value="MaintenanceEngineer">Maintenance Engineer</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>
                
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold text-secondary small text-uppercase">Password</label>
                    <input asp-for="Password" type="password" class="form-control bg-light border-0 rounded-3 py-2" placeholder="Create password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-secondary small text-uppercase">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control bg-light border-0 rounded-3 py-2" placeholder="Re-enter password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm"><i class="fas fa-save me-2"></i>Create User</button>
                <a asp-action="Users" class="btn btn-link text-muted text-decoration-none ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>