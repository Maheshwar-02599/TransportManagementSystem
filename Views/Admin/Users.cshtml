@model IEnumerable<TransportationManagement.Models.User>
@{ ViewData["Title"] = "Manage Users"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-users me-2"></i>System Users</h3>
    <a asp-action="CreateUser" class="btn btn-dark"><i class="fas fa-user-plus me-1"></i>Add User</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>Email (Username)</th><th>Password (Hashed)</th><th>Role</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @{ int i = 1; }
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@i++</td>
                        <td>@u.Username</td>
                        <td><small class="text-muted">@u.Password.Substring(0, 20)...</small></td>
                        <td><span class="badge bg-secondary">@u.Role</span></td>
                        <td>
                            <a asp-action="EditUser" asp-route-id="@u.Id" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Edit</a>
                            <form asp-action="DeleteUser" asp-route-id="@u.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Delete this user?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i> Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">No users found.</td></tr> }
            </tbody>
        </table>
    </div>
</div>
