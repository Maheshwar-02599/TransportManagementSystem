@model TransportationManagement.Models.User
@{ ViewData["Title"] = "Edit User"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-user-edit me-2"></i>Edit User</h3>
    <a asp-action="Users" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="EditUser" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Email (Username)</label>
                    <input asp-for="Username" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">New Password <small class="text-muted">(leave blank to keep current)</small></label>
                    <input type="password" name="NewPassword" class="form-control" placeholder="Enter new password" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Admin">Admin</option>
                        <option value="FleetManager">Fleet Manager</option>
                        <option value="Driver">Driver</option>
                        <option value="MaintenanceEngineer">Maintenance Engineer</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>Update User</button>
            <a asp-action="Users" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>
