@model User
@{
    ViewData["Title"] = "Edit User";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0"><i class="fas fa-user-edit text-warning me-2"></i>Edit User</h3>
    <a asp-action="Users" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    <div class="card-body">
        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Email (Username)</label>
                    <input asp-for="Username" class="form-control bg-light border-0 py-2" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold text-secondary small">Role</label>
                    <select asp-for="Role" class="form-select bg-light border-0 py-2">
                        <option value="Admin">Admin</option>
                        <option value="FleetManager">Fleet Manager</option>
                        <option value="Driver">Driver</option>
                        <option value="MaintenanceEngineer">Maintenance Engineer</option>
                    </select>
                </div>
                
                <div class="col-12 mt-4">
                    <div class="bg-warning bg-opacity-10 rounded-3 p-3 border border-warning border-opacity-25">
                        <label class="form-label fw-semibold text-dark small">
                            <i class="fas fa-lock me-2 text-warning"></i>Security Override (New Password)
                        </label>
                        <input type="password" name="NewPassword" class="form-control border-0 py-2" placeholder="Leave blank to keep current password" />
                    </div>
                </div>
            </div>
            
            <div class="mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm"><i class="fas fa-save me-2"></i>Update User</button>
                <a asp-action="Users" class="btn btn-link text-muted ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>