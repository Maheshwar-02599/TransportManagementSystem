@model IEnumerable<TransportationManagement.Models.Driver>
@{ ViewData["Title"] = "Drivers"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-id-card fa-lg px-1"></i>
        </div>
        <h3 class="mb-0 fw-bold">Fleet Drivers</h3>
    </div>
    
    @if(Context.Session.GetString("Role") == "FleetManager"){
        <a asp-action="AddDriver" class="btn btn-success rounded-pill shadow-sm px-4"><i class="fas fa-plus me-2"></i>Add Driver</a>
    }
</div>

@if (TempData["Error"] != null) {
    <div class="alert alert-danger border-0 shadow-sm rounded-3 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null) {
    <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">S.NO</th>
                    <th class="py-3 border-0">Name</th>
                    <th class="py-3 border-0">License Number</th>
                    <th class="py-3 border-0">Contact</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
            @{ 
                int rowNum = 1; 
                var activeDriverIds = ViewBag.EngagedStaffIds as List<int> ?? new List<int>();
            }
            @foreach(var drv in Model){
                
                    bool isBusy = activeDriverIds.Contains(drv.driverId);
                    string currentStatus = isBusy ? "ON_TRIP" : drv.status.ToString();
                    string badgeClass = isBusy ? "bg-warning text-dark" : (drv.status.ToString() == "AVAILABLE" ? "bg-success" : "bg-danger");
                
            <tr>
                <td class="ps-4 py-3 text-muted">@(rowNum++)</td>
                <td class="py-3 fw-semibold text-dark">@drv.name</td>
                <td class="py-3">@drv.licenseNumber</td>
                <td class="py-3">@drv.contactNumber</td>
                <td class="py-3"><span class="badge rounded-pill @badgeClass">@currentStatus</span></td>
                        <td class="text-end pe-4 py-3">
                            <a asp-action="GetDriverDetails" asp-route-id="@drv.driverId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm me-1" title="View Details"><i class="fas fa-eye"></i></a>
                            <a asp-action="GetAssignedTrips" asp-route-id="@drv.driverId" class="btn btn-light btn-sm text-primary rounded-circle shadow-sm me-1" title="View Trips"><i class="fas fa-route"></i></a>
    
                            @if (Context.Session.GetString("Role") == "FleetManager")
                            {
                                <a asp-action="Edit" asp-route-id="@drv.driverId" class="btn btn-light btn-sm text-warning rounded-circle shadow-sm me-1" title="Edit"><i class="fas fa-edit"></i></a>
        
                                <form asp-action="ToggleDriverStatus" asp-route-id="@drv.driverId" method="post" class="d-inline">
                                    @if (isBusy)
                                    {
                                        <button type="button" class="btn btn-secondary btn-sm rounded shadow-sm" disabled title="Currently on a trip">On Trip</button>
                                    }
                                    else if (drv.status.ToString() == "AVAILABLE")
                                    {
                                        <button type="submit" class="btn btn-danger btn-sm rounded shadow-sm" onclick="return confirm('Disable this driver? They will not be able to take new trips.');">Disable</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-success btn-sm rounded shadow-sm">Enable</button>
                                    }
                                </form>
                            }
                        </td>
            </tr>
            }
            @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-5">No drivers found.</td></tr>}
            </tbody>
        </table>
    </div>
</div>