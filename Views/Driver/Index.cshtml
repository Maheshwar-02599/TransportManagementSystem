@model IEnumerable<TransportationManagement.Models.Driver>
@{ ViewData["Title"] = "Drivers"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-id-card me-2"></i>Fleet Drivers</h3>
    
    @if(Context.Session.GetString("Role") == "FleetManager"){
        <a asp-action="AddDriver" class="btn btn-success"><i class="fas fa-plus me-1"></i>Add Driver</a>
    }
</div>

@if (TempData["Error"] != null) {
    <div class="alert alert-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null) {
    <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>Name</th><th>License Number</th><th>Contact</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @{ 
                int rowNum = 1; 
                var activeDriverIds = ViewBag.EngagedStaffIds as List<int> ?? new List<int>();
            }
            @foreach(var drv in Model){
                
                    bool isBusy = activeDriverIds.Contains(drv.driverId);
                    string currentStatus = isBusy ? "ON_TRIP" : drv.status.ToString();
                    string badgeClass = isBusy ? "bg-warning text-dark" : (drv.status.ToString() == "AVAILABLE" ? "bg-success" : "bg-danger");
                
            <tr>
                <td>@(rowNum++)</td>
                <td><strong>@drv.name</strong></td>
                <td>@drv.licenseNumber</td>
                <td>@drv.contactNumber</td>
                <td><span class="badge @badgeClass">@currentStatus</span></td>
                <td>
                    <a asp-action="GetDriverDetails" asp-route-id="@drv.driverId" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                    <a asp-action="GetAssignedTrips" asp-route-id="@drv.driverId" class="btn btn-primary btn-sm"><i class="fas fa-route"></i></a>
                    
                    @if(Context.Session.GetString("Role") == "FleetManager"){
                        <a asp-action="Edit" asp-route-id="@drv.driverId" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                        <a asp-action="Delete" asp-route-id="@drv.driverId" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
                    }
                </td>
            </tr>
            }
            @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-3">No drivers found.</td></tr>}
            </tbody>
        </table>
    </div>
</div>