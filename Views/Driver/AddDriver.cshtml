@model TransportationManagement.Models.Driver
@{
    ViewData["Title"] = "Add Driver";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-success bg-opacity-10 text-success rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-user-plus fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Add New Driver</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <form asp-action="AddDriver" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 rounded-3 border-0"></div>
            
            <div class="row g-4 mb-3">
                <div class="col-md-6">
                    <label asp-for="name" class="form-label fw-semibold text-secondary small text-uppercase">Full Name</label>
                    <input asp-for="name" class="form-control bg-light border-0 rounded-3 py-2" placeholder="Driver Full Name" />
                    <span asp-validation-for="name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="licenseNumber" class="form-label fw-semibold text-secondary small text-uppercase">License Number</label>
                    <input asp-for="licenseNumber" class="form-control bg-light border-0 rounded-3 py-2" placeholder="e.g. TN0120230001234" />
                    <span asp-validation-for="licenseNumber" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="contactNumber" class="form-label fw-semibold text-secondary small text-uppercase">Contact Number</label>
                    <input asp-for="contactNumber" class="form-control bg-light border-0 rounded-3 py-2" placeholder="e.g. 9876543210" />
                    <span asp-validation-for="contactNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="status" class="form-label fw-semibold text-secondary small text-uppercase">Status</label>
                    <select asp-for="status" class="form-select bg-light border-0 rounded-3 py-2">
                        <option value="AVAILABLE">AVAILABLE</option>
                        <option value="ON_TRIP">ON_TRIP</option>
                        <option value="INACTIVE">INACTIVE</option>
                    </select>
                </div>
            </div>
            
            <div class="mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm"><i class="fas fa-save me-2"></i>Save Driver</button>
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>