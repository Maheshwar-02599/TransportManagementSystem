@model TransportationManagement.ViewModels.CreateDriverViewModel
@{ ViewData["Title"] = "Add Driver"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-user-plus me-2"></i>Add New Driver</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <form asp-action="AddDriver" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Driver.name" class="form-label fw-semibold">Full Name</label>
                <input asp-for="Driver.name" class="form-control" placeholder="Driver Full Name" /><span asp-validation-for="Driver.name" class="text-danger small"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="Driver.licenseNumber" class="form-label fw-semibold">License Number</label>
                <input asp-for="Driver.licenseNumber" class="form-control" placeholder="e.g. TN0120230001234" /><span asp-validation-for="Driver.licenseNumber" class="text-danger small"></span></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Driver.contactNumber" class="form-label fw-semibold">Contact Number</label>
                <input asp-for="Driver.contactNumber" class="form-control" placeholder="e.g. 9876543210" /><span asp-validation-for="Driver.contactNumber" class="text-danger small"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="Driver.status" class="form-label fw-semibold">Status</label>
                <select asp-for="Driver.status" class="form-select"><option value="AVAILABLE">AVAILABLE</option><option value="ON_TRIP">ON_TRIP</option><option value="INACTIVE">INACTIVE</option></select></div>
        </div>

        <hr />
        <h5>Driver Login Credentials</h5>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="Username" class="form-label fw-semibold">Email</label>
                <input asp-for="Username" class="form-control" placeholder="driver@example.com" /><span asp-validation-for="Username" class="text-danger small"></span></div>
            <div class="col-md-3 mb-3"><label asp-for="Password" class="form-label fw-semibold">Password</label>
                <input asp-for="Password" class="form-control" type="password" /><span asp-validation-for="Password" class="text-danger small"></span></div>
            <div class="col-md-3 mb-3"><label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" /><span asp-validation-for="ConfirmPassword" class="text-danger small"></span></div>
        </div>

        <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i>Save Driver</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
