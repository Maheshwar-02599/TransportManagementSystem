@model TransportationManagement.Models.Driver
@{ ViewData["Title"] = "Edit Driver"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-edit me-2"></i>Edit Driver</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="driverId" />
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="name" class="form-label fw-semibold">Full Name</label><input asp-for="name" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="licenseNumber" class="form-label fw-semibold">License Number</label><input asp-for="licenseNumber" class="form-control" /></div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="contactNumber" class="form-label fw-semibold">Contact Number</label><input asp-for="contactNumber" class="form-control" /></div>
            <div class="col-md-6 mb-3"><label asp-for="status" class="form-label fw-semibold">Status</label>
                <select asp-for="status" class="form-select"><option value="AVAILABLE">AVAILABLE</option><option value="ON_TRIP">ON_TRIP</option><option value="INACTIVE">INACTIVE</option></select></div>
        </div>
        <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>Update Driver</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
