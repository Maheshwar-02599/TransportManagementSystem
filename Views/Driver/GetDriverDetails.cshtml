@model TransportationManagement.Models.Driver
@{
    ViewData["Title"] = "Driver Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-info bg-opacity-10 text-info rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-id-card-alt fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Driver Details</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Driver ID</div>
            <div class="col-md-9 text-dark">@Model.driverId</div>
        </div>
        
        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Name</div>
            <div class="col-md-9 fw-semibold text-dark fs-5">@Model.name</div>
        </div>

        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">License Number</div>
            <div class="col-md-9 text-dark font-monospace">@Model.licenseNumber</div>
        </div>

        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Contact</div>
            <div class="col-md-9 text-dark">@Model.contactNumber</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase align-self-center">Status</div>
            <div class="col-md-9">
                <span class="badge rounded-pill @(Model.status == DriverStatus.AVAILABLE ? "bg-success" : Model.status == DriverStatus.INACTIVE ? "bg-warning text-dark" : "bg-danger") fs-6 px-3 py-2">
                    @Model.status
                </span>
            </div>
        </div>
        
        @if (Context.Session.GetString("Role") == "FleetManager")
        {
            <div class="mt-4 pt-4 border-top">
                <a asp-action="Edit" asp-route-id="@Model.driverId" class="btn btn-warning rounded-pill px-4 shadow-sm me-2"><i class="fas fa-edit me-2"></i>Edit Profile</a>
            </div>
        }
    </div>
</div>