@model TransportationManagement.Models.Driver
@{ ViewData["Title"] = "Driver Details"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-id-card me-2"></i>Driver Details</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Driver ID</dt><dd class="col-sm-9">@Model.driverId</dd>
        <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.name</dd>
        <dt class="col-sm-3">License Number</dt><dd class="col-sm-9">@Model.licenseNumber</dd>
        <dt class="col-sm-3">Contact</dt><dd class="col-sm-9">@Model.contactNumber</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @(Model.status==DriverStatus.AVAILABLE?"bg-success":Model.status==DriverStatus.INACTIVE?"bg-warning text-dark":"bg-danger")">@Model.status</span></dd>
    </dl>
</div></div>
