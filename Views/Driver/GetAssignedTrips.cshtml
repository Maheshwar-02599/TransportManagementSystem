@model IEnumerable<TransportationManagement.Models.Trip>
@{
    ViewData["Title"] = "Assigned Trips";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-route fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Trips for @ViewBag.DriverName</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back to Drivers</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">Trip ID</th>
                    <th class="py-3 border-0">Origin</th>
                    <th class="py-3 border-0">Destination</th>
                    <th class="py-3 border-0">Vehicle No.</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 fw-bold text-muted">#@t.tripId</td>
                        <td class="py-3">@t.origin</td>
                        <td class="py-3">@t.destination</td>
                        <td class="py-3 font-monospace">@(t.Vehicle?.vehicleNumber ?? "N/A")</td>
                        <td class="py-3">
                            <span class="badge rounded-pill @(t.tripStatus == TripStatus.COMPLETED ? "bg-success" : t.tripStatus == TripStatus.IN_PROGRESS ? "bg-warning text-dark" : "bg-info")">
                                @t.tripStatus
                            </span>
                        </td>
                        <td class="text-end pe-4 py-3">
                            @if (Context.Session.GetString("Role") == "Driver")
                            {
                                if (t.tripStatus != TripStatus.IN_PROGRESS && t.tripStatus != TripStatus.COMPLETED)
                                {
                                    <form asp-controller="Trip" asp-action="StartTrip" asp-route-id="@t.tripId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm me-1"><i class="fas fa-play me-1"></i>Start</button>
                                    </form>
                                }

                                if (t.tripStatus == TripStatus.IN_PROGRESS)
                                {
                                    <button type="button" class="btn btn-danger btn-sm rounded-pill shadow-sm px-3 me-1" data-bs-toggle="modal" data-bs-target="#endTripModal-@t.tripId">
                                        <i class="fas fa-stop me-1"></i>End
                                    </button>

                                    <div class="modal fade text-start" id="endTripModal-@t.tripId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow-lg rounded-4">
                                                <div class="modal-header border-0 bg-light rounded-top-4 pb-0 pt-4 px-4">
                                                    <h5 class="modal-title fw-bold text-dark"><i class="fas fa-flag-checkered text-success me-2"></i>Complete Trip #@t.tripId</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-controller="Trip" asp-action="EndTrip" method="post">
                                                    <div class="modal-body p-4">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@t.tripId" />
                                                        
                                                        <p class="text-muted mb-4">Please enter the total distance traveled. The system will automatically update the vehicle's odometer and log the fuel consumption.</p>
                                                        
                                                        <div class="form-floating mb-3">
                                                            <input type="number" name="distanceTraveled" class="form-control bg-light border-0 rounded-3 fw-bold text-primary" id="dist-@t.tripId" placeholder="Distance in km" required min="1" />
                                                            <label for="dist-@t.tripId"><i class="fas fa-road me-2 text-muted"></i>Distance Traveled (km)</label>
                                                        </div>
                                                        
                                                        <div class="alert alert-info bg-info bg-opacity-10 border-0 rounded-3 small mb-0 fw-medium">
                                                            <i class="fas fa-magic me-2 text-info"></i> Auto-calculating fuel at 10 km/L (Rs. 100/L).
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-between">
                                                        <button type="button" class="btn btn-light rounded-pill px-4 fw-medium" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold"><i class="fas fa-check-circle me-2"></i>Confirm & End</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            <a asp-controller="Trip" asp-action="GetTripPlan" asp-route-id="@t.tripId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm" title="View Plan">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No trips assigned to this driver.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>