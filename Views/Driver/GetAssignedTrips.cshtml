@model IEnumerable<TransportationManagement.Models.Trip>
@{
    ViewData["Title"] = "Assigned Trips";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-route me-2"></i>Trips for @ViewBag.DriverName</h3>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Trip ID</th>
                    <th>Origin</th>
                    <th>Destination</th>
                    <th>Vehicle No.</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td><strong>#@t.tripId</strong></td> @* Using tripId from your schema *@
                        <td>@t.origin</td>
                        <td>@t.destination</td>
                        <td>@(t.Vehicle?.vehicleNumber ?? "N/A")</td> @* Using vehicleNumber *@
                        <td>
                            <span class="badge @(t.tripStatus == TripStatus.COMPLETED ? "bg-success" : t.tripStatus == TripStatus.IN_PROGRESS ? "bg-warning text-dark" : "bg-info")">
                                @t.tripStatus
                            </span>
                        </td>
                        <td>
                            @* Action buttons for the Driver (driver controls Start/End) *@
                            @if (Context.Session.GetString("Role") == "Driver")
                            {
                                if (t.tripStatus != TripStatus.IN_PROGRESS && t.tripStatus != TripStatus.COMPLETED)
                                {
                                    <form asp-controller="Trip" asp-action="StartTrip" asp-route-id="@t.tripId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-success btn-sm">Start Trip</button>
                                    </form>
                                }

                                if (t.tripStatus == TripStatus.IN_PROGRESS)
                                {
                                    <form asp-controller="Trip" asp-action="EndTrip" asp-route-id="@t.tripId" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm">End Trip</button>
                                    </form>
                                }
                            }

                            <a asp-controller="Trip" asp-action="GetTripPlan" asp-route-id="@t.tripId" class="btn btn-info btn-sm">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No trips assigned to this driver.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>