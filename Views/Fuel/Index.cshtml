@model IEnumerable<TransportationManagement.Models.FuelEntry>
@{
    ViewData["Title"] = "Fuel Usage Logs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-info bg-opacity-10 text-info rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-gas-pump fa-lg px-1"></i>
        </div>
        <h3 class="mb-0 fw-bold">Fuel Usage</h3>
    </div>
    
    <div>
        <a asp-action="GenerateFuelReport" class="btn btn-light text-primary border shadow-sm rounded-pill px-4 fw-semibold">
            <i class="fas fa-file-alt me-2"></i>Report
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">S.NO</th>
                    <th class="py-3 border-0">Vehicle</th>
                    <th class="py-3 border-0">Quantity</th>
                    <th class="py-3 border-0">Cost</th>
                    <th class="py-3 border-0">Odometer</th>
                    <th class="py-3 border-0">Date</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @{
                    int i = 1;
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 text-muted">@(i++)</td>
                        <td class="py-3 fw-semibold text-dark font-monospace">@(item.Vehicle?.vehicleNumber ?? "-")</td>
                        <td class="py-3 text-dark">@item.fuelQuantity.ToString("0.00") L</td>
                        <td class="py-3 text-dark">Rs. @item.fuelCost.ToString("0.00")</td>
                        <td class="py-3 text-muted">@item.odometerReading km</td>
                        <td class="py-3 text-muted">@item.entryDate.ToString("dd-MM-yyyy")</td>
                        <td class="text-end pe-4 py-3">
                            <a asp-action="GetFuelEntryDetails" asp-route-id="@item.fuelId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm" title="View Details">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No automated fuel logs found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>