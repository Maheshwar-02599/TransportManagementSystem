@model IEnumerable<TransportationManagement.Models.FuelEntry>
@{
    ViewData["Title"] = "Fuel Entries";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-gas-pump me-2"></i>Fuel Usage</h3>
    <div>
        @if (Context.Session.GetString("Role") == "FleetManager")
        {
            <a asp-action="AddFuelEntry" class="btn btn-success"><i class="fas fa-plus me-1"></i>Add Fuel Entry</a>
        }
        
        <a asp-action="GenerateFuelReport" class="btn btn-outline-secondary ms-2"><i class="fas fa-file-alt me-1"></i>Report</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>Vehicle</th><th>Quantity (L)</th><th>Cost (Rs.)</th><th>Odometer (km)</th><th>Entry Date</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var f in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@(f.Vehicle?.vehicleNumber ?? "-")</td>
                        <td>@f.fuelQuantity L</td>
                        <td>Rs. @f.fuelCost</td>
                        <td>@f.odometerReading km</td>
                        <td>@f.entryDate.ToString("dd-MM-yyyy")</td>
                        <td>
                            <a asp-action="GetFuelEntryDetails" asp-route-id="@f.fuelId" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                            
                            @if (Context.Session.GetString("Role") == "FleetManager")
                            {
                                <a asp-action="Edit" asp-route-id="@f.fuelId" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@f.fuelId" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">No fuel entries found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>