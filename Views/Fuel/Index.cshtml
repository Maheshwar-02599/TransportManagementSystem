@model IEnumerable<TransportationManagement.Models.FuelEntry>
@{
    ViewData["Title"] = "Fuel Entries";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-info bg-opacity-10 text-info rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-gas-pump fa-lg px-1"></i>
        </div>
        <h3 class="mb-0 fw-bold">Fuel Usage</h3>
    </div>
    
    <div>
        @if (Context.Session.GetString("Role") == "FleetManager")
        {
            <a asp-action="AddFuelEntry" class="btn btn-success rounded-pill shadow-sm px-4"><i class="fas fa-plus me-2"></i>Add Fuel Entry</a>
        }
        <a asp-action="GenerateFuelReport" class="btn btn-light border shadow-sm rounded-pill px-4 ms-2"><i class="fas fa-file-alt me-2 text-primary"></i>Report</a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">#</th>
                    <th class="py-3 border-0">Vehicle</th>
                    <th class="py-3 border-0">Quantity</th>
                    <th class="py-3 border-0">Cost</th>
                    <th class="py-3 border-0">Odometer</th>
                    <th class="py-3 border-0">Date</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @{
                    int i = 1;
                }
                @foreach (var f in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 text-muted">@(i++)</td>
                        <td class="py-3 fw-semibold text-dark">@(f.Vehicle?.vehicleNumber ?? "-")</td>
                        <td class="py-3">@f.fuelQuantity L</td>
                        <td class="py-3 font-monospace">Rs. @f.fuelCost</td>
                        <td class="py-3">@f.odometerReading km</td>
                        <td class="py-3">@f.entryDate.ToString("dd-MM-yyyy")</td>
                        <td class="text-end pe-4 py-3">
                            <a asp-action="GetFuelEntryDetails" asp-route-id="@f.fuelId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm me-1" title="View"><i class="fas fa-eye"></i></a>
                            
                            @if (Context.Session.GetString("Role") == "FleetManager")
                            {
                                <a asp-action="Edit" asp-route-id="@f.fuelId" class="btn btn-light btn-sm text-warning rounded-circle shadow-sm me-1" title="Edit"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@f.fuelId" class="btn btn-light btn-sm text-danger rounded-circle shadow-sm" title="Delete"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No fuel entries found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>