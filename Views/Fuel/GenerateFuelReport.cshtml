@model IEnumerable<TransportationManagement.Models.FuelEntry>
@{
    ViewData["Title"] = "Fuel Report";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-chart-bar fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Fuel Consumption Report</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white">
            <div class="text-secondary mb-2 small text-uppercase tracking-wide fw-bold">Total Entries</div>
            <h2 class="fw-bold text-dark mb-0">@(Model?.Count() ?? 0)</h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white">
            <div class="text-secondary mb-2 small text-uppercase tracking-wide fw-bold">Total Fuel Consumed</div>
            <h2 class="fw-bold text-info mb-0">@(Model?.Any() == true ? Model.Sum(f => f.fuelQuantity).ToString("F2") : "0.00") <span class="fs-5 text-muted">L</span></h2>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 text-center h-100 bg-white">
            <div class="text-secondary mb-2 small text-uppercase tracking-wide fw-bold">Total Expenditure</div>
            <h2 class="fw-bold text-success mb-0"><span class="fs-5 text-muted">Rs.</span> @(Model?.Any() == true ? Model.Sum(f => f.fuelCost).ToString("F2") : "0.00")</h2>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">#</th>
                    <th class="py-3 border-0">Vehicle</th>
                    <th class="py-3 border-0">Quantity (L)</th>
                    <th class="py-3 border-0">Cost (Rs.)</th>
                    <th class="py-3 border-0">Odometer</th>
                    <th class="py-3 border-0">Date</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var f in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 text-muted">@(i++)</td>
                            <td class="py-3 fw-semibold">@(f.Vehicle?.vehicleNumber ?? "-")</td>
                            <td class="py-3">@f.fuelQuantity</td>
                            <td class="py-3 text-success fw-semibold">Rs. @f.fuelCost</td>
                            <td class="py-3">@f.odometerReading km</td>
                            <td class="py-3">@f.entryDate.ToString("dd-MMM-yyyy")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-5">No report data found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>  