@model IEnumerable<TransportationManagement.Models.FuelEntry>
@{ ViewData["Title"] = "Fuel Report"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-file-alt me-2"></i>Fuel Consumption Report</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="row g-3 mb-3">
    <div class="col-md-3"><div class="card text-center p-3 bg-light"><strong>Total Entries</strong><h3>@Model.Count()</h3></div></div>
    <div class="col-md-3"><div class="card text-center p-3 bg-light"><strong>Total Fuel (L)</strong><h3>@Model.Sum(f=>f.fuelQuantity).ToString("F2")</h3></div></div>
    <div class="col-md-3"><div class="card text-center p-3 bg-light"><strong>Total Cost (Rs.)</strong><h3>Rs. @Model.Sum(f=>f.fuelCost).ToString("F2")</h3></div></div>
</div>
<div class="card"><div class="card-body p-0">
    <table class="table table-striped mb-0">
        <thead class="table-dark"><tr><th>#</th><th>Vehicle</th><th>Quantity (L)</th><th>Cost (Rs.)</th><th>Odometer</th><th>Date</th></tr></thead>
        <tbody>
        @{ int i=1; }
        @foreach(var f in Model){
        <tr><td>@i++</td><td>@(f.Vehicle?.vehicleNumber??"-")</td><td>@f.fuelQuantity</td><td>Rs. @f.fuelCost</td><td>@f.odometerReading km</td><td>@f.entryDate.ToString("dd-MM-yyyy")</td></tr>}
        </tbody>
    </table>
</div></div>
