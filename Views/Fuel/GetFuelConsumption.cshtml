@model IEnumerable<TransportationManagement.Models.FuelEntry>
@{
    ViewData["Title"] = "Fuel Consumption";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-info bg-opacity-10 text-info rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-gas-pump fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Vehicle Fuel Consumption</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">#</th>
                    <th class="py-3 border-0">Quantity (L)</th>
                    <th class="py-3 border-0">Cost (Rs.)</th>
                    <th class="py-3 border-0">Odometer</th>
                    <th class="py-3 border-0">Date</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @if (Model != null && Model.Any())
                {
                    int i = 1;
                    foreach (var f in Model)
                    {
                        <tr>
                            <td class="ps-4 py-3 text-muted">@(i++)</td>
                            <td class="py-3 fw-semibold text-dark">@f.fuelQuantity L</td>
                            <td class="py-3 font-monospace text-success fw-semibold">Rs. @f.fuelCost</td>
                            <td class="py-3">@f.odometerReading km</td>
                            <td class="py-3">
                                <span class="badge bg-light text-dark border px-2 py-1 fs-6">@f.entryDate.ToString("dd MMM yyyy")</span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">No fuel consumption data found for this vehicle.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>