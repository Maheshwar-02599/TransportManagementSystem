@model TransportationManagement.Models.FuelEntry
@{ ViewData["Title"] = "Add Fuel Entry"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-gas-pump me-2"></i>Add Fuel Entry</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <form asp-action="AddFuelEntry" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="vehicleId" class="form-label fw-semibold">Vehicle</label>
                <select asp-for="vehicleId" asp-items="ViewBag.Vehicles" class="form-select"><option value="">-- Select Vehicle --</option></select>
                <span asp-validation-for="vehicleId" class="text-danger small"></span></div>
            <div class="col-md-6 mb-3"><label asp-for="entryDate" class="form-label fw-semibold">Entry Date</label>
                <input asp-for="entryDate" type="date" class="form-control" />
                <span asp-validation-for="entryDate" class="text-danger small"></span></div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="fuelQuantity" class="form-label fw-semibold">Fuel Quantity (Litres)</label>
                <input asp-for="fuelQuantity" type="number" step="0.01" class="form-control" placeholder="e.g. 50.00" /></div>
            <div class="col-md-4 mb-3"><label asp-for="fuelCost" class="form-label fw-semibold">Fuel Cost (Rs.)</label>
                <input asp-for="fuelCost" type="number" step="0.01" class="form-control" placeholder="e.g. 4500.00" /></div>
            <div class="col-md-4 mb-3"><label asp-for="odometerReading" class="form-label fw-semibold">Odometer Reading (km)</label>
                <input asp-for="odometerReading" type="number" class="form-control" placeholder="e.g. 12500" /></div>
        </div>
        <button type="submit" class="btn btn-success"><i class="fas fa-save me-1"></i>Save Entry</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
