@model TransportationManagement.Models.FuelEntry
@{
    ViewData["Title"] = "Fuel Entry Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-info bg-opacity-10 text-info rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-file-invoice-dollar fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Fuel Record Details</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Record ID</div>
            <div class="col-md-9 text-dark">@Model.fuelId</div>
        </div>
        
        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Vehicle Number</div>
            <div class="col-md-9 fw-semibold text-dark fs-5">@(Model.Vehicle?.vehicleNumber ?? "Unknown")</div>
        </div>

        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Fuel Quantity</div>
            <div class="col-md-9 text-dark">@Model.fuelQuantity Liters</div>
        </div>

        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Total Cost</div>
            <div class="col-md-9 text-dark font-monospace fw-semibold text-success">Rs. @Model.fuelCost</div>
        </div>

        <div class="row mb-4 border-bottom pb-3">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase">Odometer Reading</div>
            <div class="col-md-9 text-dark">@Model.odometerReading km</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold text-secondary small text-uppercase align-self-center">Date of Entry</div>
            <div class="col-md-9">
                <span class="badge bg-light text-dark border px-3 py-2 fs-6">@Model.entryDate.ToString("dd MMM yyyy")</span>
            </div>
        </div>

        @if (Context.Session.GetString("Role") == "FleetManager")
        {
            <div class="mt-4 pt-4 border-top">
                <a asp-action="Edit" asp-route-id="@Model.fuelId" class="btn btn-warning rounded-pill px-4 shadow-sm me-2"><i class="fas fa-edit me-2"></i>Edit Entry</a>
                <a asp-action="Delete" asp-route-id="@Model.fuelId" class="btn btn-outline-danger rounded-pill px-4"><i class="fas fa-trash me-2"></i>Delete</a>
            </div>
        }
    </div>
</div>