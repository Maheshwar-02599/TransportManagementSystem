@model TransportationManagement.Models.FuelEntry
@{
    ViewData["Title"] = "Fuel Entry Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fas fa-gas-pump me-2"></i>Fuel Record Details</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Record ID</div>
            <div class="col-md-9">@Model.fuelId</div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Vehicle Number</div>
            <div class="col-md-9"><strong>@(Model.Vehicle?.vehicleNumber ?? "Unknown")</strong></div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Fuel Quantity</div>
            <div class="col-md-9">@Model.fuelQuantity Liters</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Total Cost</div>
            <div class="col-md-9">Rs. @Model.fuelCost</div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 fw-bold text-muted">Odometer Reading</div>
            <div class="col-md-9">@Model.odometerReading km</div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 fw-bold text-muted">Date of Entry</div>
            <div class="col-md-9">@Model.entryDate.ToString("dd MMM yyyy")</div>
        </div>

        @if (Context.Session.GetString("Role") == "FleetManager")
        {
            <div class="border-top pt-3 mt-2">
                <a asp-action="Edit" asp-route-id="@Model.fuelId" class="btn btn-warning me-2">
                    <i class="fas fa-edit me-1"></i>Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.fuelId" class="btn btn-danger">
                    <i class="fas fa-trash me-1"></i>Delete
                </a>
            </div>
        }
    </div>
</div>