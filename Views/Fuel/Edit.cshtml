@model TransportationManagement.Models.FuelEntry
@{ ViewData["Title"] = "Edit Fuel Entry"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-edit me-2"></i>Edit Fuel Entry</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="fuelId" />
        <div class="row">
            <div class="col-md-6 mb-3"><label asp-for="vehicleId" class="form-label fw-semibold">Vehicle</label>
                <select asp-for="vehicleId" asp-items="ViewBag.Vehicles" class="form-select"></select></div>
            <div class="col-md-6 mb-3"><label asp-for="entryDate" class="form-label fw-semibold">Entry Date</label>
                <input asp-for="entryDate" type="date" class="form-control" /></div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3"><label asp-for="fuelQuantity" class="form-label fw-semibold">Fuel Quantity (L)</label>
                <input asp-for="fuelQuantity" type="number" step="0.01" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="fuelCost" class="form-label fw-semibold">Fuel Cost (Rs.)</label>
                <input asp-for="fuelCost" type="number" step="0.01" class="form-control" /></div>
            <div class="col-md-4 mb-3"><label asp-for="odometerReading" class="form-label fw-semibold">Odometer (km)</label>
                <input asp-for="odometerReading" type="number" class="form-control" /></div>
        </div>
        <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>Update</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
