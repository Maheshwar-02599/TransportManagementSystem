@model TransportationManagement.Models.FuelEntry
@{
    ViewData["Title"] = "Edit Fuel Entry";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-edit fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Edit Fuel Entry</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="fuelId" />
            
            <div class="row g-4 mb-3">
                <div class="col-md-6">
                    <label asp-for="vehicleId" class="form-label fw-semibold text-secondary small text-uppercase">Vehicle</label>
                    <select asp-for="vehicleId" asp-items="ViewBag.Vehicles" class="form-select bg-light border-0 rounded-3 py-2"></select>
                </div>
                <div class="col-md-6">
                    <label asp-for="entryDate" class="form-label fw-semibold text-secondary small text-uppercase">Entry Date</label>
                    <input asp-for="entryDate" type="date" class="form-control bg-light border-0 rounded-3 py-2" />
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-md-4">
                    <label asp-for="fuelQuantity" class="form-label fw-semibold text-secondary small text-uppercase">Quantity (Litres)</label>
                    <input asp-for="fuelQuantity" type="number" step="0.01" class="form-control bg-light border-0 rounded-3 py-2" />
                </div>
                <div class="col-md-4">
                    <label asp-for="fuelCost" class="form-label fw-semibold text-secondary small text-uppercase">Cost (Rs.)</label>
                    <input asp-for="fuelCost" type="number" step="0.01" class="form-control bg-light border-0 rounded-3 py-2" />
                </div>
                <div class="col-md-4">
                    <label asp-for="odometerReading" class="form-label fw-semibold text-secondary small text-uppercase">Odometer (km)</label>
                    <input asp-for="odometerReading" type="number" class="form-control bg-light border-0 rounded-3 py-2" />
                </div>
            </div>
            
            <div class="mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm"><i class="fas fa-save me-2"></i>Update Entry</button>
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>