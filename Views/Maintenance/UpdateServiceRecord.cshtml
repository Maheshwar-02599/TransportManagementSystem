@model TransportationManagement.Models.MaintenanceRecord
@{
    ViewData["Title"] = "Update Service Record";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-edit me-2"></i>Update Service Record</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card">
    <div class="card-body">
        <form asp-action="UpdateServiceRecord" method="post">
            
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            
            <input type="hidden" asp-for="maintenanceId" />
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="vehicleId" class="form-label fw-semibold">Vehicle</label>
                    <select asp-for="vehicleId" asp-items="ViewBag.Vehicles" class="form-select"></select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="serviceType" class="form-label fw-semibold">Service Type</label>
                    <input asp-for="serviceType" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="serviceDate" class="form-label fw-semibold">Service Date</label>
                    <input asp-for="serviceDate" type="date" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="remarks" class="form-label fw-semibold">Remarks</label>
                    <input asp-for="remarks" class="form-control" />
                </div>
            </div>
            <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>Update Record</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </form>
    </div>
</div>