@model TransportationManagement.Models.MaintenanceRecord
@{
    ViewData["Title"] = "Maintenance Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fas fa-wrench me-2"></i>Maintenance Record Details</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Record ID</div>
            <div class="col-md-9">@Model.maintenanceId</div>
        </div>
        
        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Vehicle Number</div>
            <div class="col-md-9"><strong>@(Model.Vehicle?.vehicleNumber ?? "Unknown")</strong></div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Service Type</div>
            <div class="col-md-9">@Model.serviceType</div>
        </div>

        <div class="row mb-3">
            <div class="col-md-3 fw-bold text-muted">Service Date</div>
            <div class="col-md-9">@Model.serviceDate.ToString("dd MMM yyyy")</div>
        </div>

        <div class="row mb-4">
            <div class="col-md-3 fw-bold text-muted">Remarks</div>
            <div class="col-md-9">@(string.IsNullOrWhiteSpace(Model.remarks) ? "No remarks provided." : Model.remarks)</div>
        </div>

        @if (Context.Session.GetString("Role") == "FleetManager" || Context.Session.GetString("Role") == "MaintenanceEngineer")
        {
            <div class="border-top pt-3 mt-2">
                <a asp-action="UpdateServiceRecord" asp-route-id="@Model.maintenanceId" class="btn btn-warning me-2">
                    <i class="fas fa-edit me-1"></i>Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.maintenanceId" class="btn btn-danger">
                    <i class="fas fa-trash me-1"></i>Delete
                </a>
            </div>
        }
    </div>
</div>