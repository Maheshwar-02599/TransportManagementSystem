@model TransportationManagement.Models.MaintenanceRecord
@{
    ViewData["Title"] = "Schedule Maintenance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-calendar-check fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Schedule Maintenance</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <form asp-action="ScheduleMaintenance" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 rounded-3 border-0"></div>
            
            <div class="row g-4 mb-3">
                <div class="col-md-6">
                    <label asp-for="vehicleId" class="form-label fw-semibold text-secondary small text-uppercase">Vehicle</label>
                    <select asp-for="vehicleId" asp-items="ViewBag.Vehicles" class="form-select bg-light border-0 rounded-3 py-2">
                        <option value="">-- Select Vehicle --</option>
                    </select>
                    <span asp-validation-for="vehicleId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="serviceType" class="form-label fw-semibold text-secondary small text-uppercase">Service Type</label>
                    <input asp-for="serviceType" class="form-control bg-light border-0 rounded-3 py-2" placeholder="e.g. Oil Change, Tyre Check" />
                    <span asp-validation-for="serviceType" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="serviceDate" class="form-label fw-semibold text-secondary small text-uppercase">Service Date</label>
                    <input asp-for="serviceDate" type="date" class="form-control bg-light border-0 rounded-3 py-2" />
                    <span asp-validation-for="serviceDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="remarks" class="form-label fw-semibold text-secondary small text-uppercase">Remarks</label>
                    <input asp-for="remarks" class="form-control bg-light border-0 rounded-3 py-2" placeholder="Optional notes" />
                </div>
            </div>
            
            <div class="mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-danger rounded-pill px-4 shadow-sm"><i class="fas fa-save me-2"></i>Schedule Service</button>
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>