@model IEnumerable<TransportationManagement.Models.MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-wrench fa-lg px-1"></i>
        </div>
        <h3 class="mb-0 fw-bold">Maintenance Records</h3>
    </div>
    
    @if (Context.Session.GetString("Role") == "FleetManager" || Context.Session.GetString("Role") == "MaintenanceEngineer")
    {
        <a asp-action="ScheduleMaintenance" class="btn btn-danger rounded-pill shadow-sm px-4"><i class="fas fa-plus me-2"></i>Schedule Maintenance</a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">#</th>
                    <th class="py-3 border-0">Vehicle</th>
                    <th class="py-3 border-0">Service Type</th>
                    <th class="py-3 border-0">Service Date</th>
                    <th class="py-3 border-0">Remarks</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @{
                    int i = 1;
                }
                @foreach (var m in Model)
                {
                    // --- LOGIC: Check if the record is frozen/completed ---
                    bool isCompleted = !string.IsNullOrEmpty(m.remarks) && m.remarks.Contains("[COMPLETED]");
                    string cleanRemarks = string.IsNullOrEmpty(m.remarks) ? "-" : m.remarks.Replace("[COMPLETED]", "").Trim();
                    if (string.IsNullOrEmpty(cleanRemarks)) cleanRemarks = "-";
                    // ------------------------------------------------------
                    
                    <tr>
                        <td class="ps-4 py-3 text-muted">@(i++)</td>
                        <td class="py-3 fw-semibold text-dark">@(m.Vehicle?.vehicleNumber ?? "-")</td>
                        <td class="py-3">@m.serviceType</td>
                        <td class="py-3">@m.serviceDate.ToString("dd MMM yyyy")</td>
                        <td class="py-3 text-muted">@cleanRemarks</td>
                        <td class="py-3">
                            @if (isCompleted)
                            {
                                <span class="badge rounded-pill bg-success"><i class="fas fa-check-double me-1"></i>Completed</span>
                            }
                            else
                            {
                                <span class="badge rounded-pill bg-warning text-dark"><i class="fas fa-tools me-1"></i>In Service</span>
                            }
                        </td>
                        <td class="text-end pe-4 py-3">
                            <a asp-action="GetMaintenanceDetails" asp-route-id="@m.maintenanceId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm me-1" title="View"><i class="fas fa-eye"></i></a>
                            
                            @if (Context.Session.GetString("Role") == "FleetManager" || Context.Session.GetString("Role") == "MaintenanceEngineer")
                            {
                                @if (!isCompleted)
                                {
                                    <form asp-action="CompleteMaintenance" asp-route-id="@m.maintenanceId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-light btn-sm text-success rounded-circle shadow-sm me-1" title="Mark Completed"><i class="fas fa-check"></i></button>
                                    </form>
                                    <a asp-action="UpdateServiceRecord" asp-route-id="@m.maintenanceId" class="btn btn-light btn-sm text-warning rounded-circle shadow-sm me-1" title="Edit"><i class="fas fa-edit"></i></a>
                                    <a asp-action="Delete" asp-route-id="@m.maintenanceId" class="btn btn-light btn-sm text-danger rounded-circle shadow-sm" title="Delete"><i class="fas fa-trash"></i></a>
                                }
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No maintenance records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>