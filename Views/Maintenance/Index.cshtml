@model IEnumerable<TransportationManagement.Models.MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-wrench me-2"></i>Maintenance Records</h3>
    
    @if (Context.Session.GetString("Role") == "FleetManager" || Context.Session.GetString("Role") == "MaintenanceEngineer")
    {
        <a asp-action="ScheduleMaintenance" class="btn btn-danger"><i class="fas fa-plus me-1"></i>Schedule Maintenance</a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>Vehicle</th><th>Service Type</th><th>Service Date</th><th>Remarks</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@(m.Vehicle?.vehicleNumber ?? "-")</td>
                        <td>@m.serviceType</td>
                        <td>@m.serviceDate.ToString("dd-MM-yyyy")</td>
                        <td>@(m.remarks ?? "-")</td>
                        <td>
                            <a asp-action="GetMaintenanceDetails" asp-route-id="@m.maintenanceId" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                            
                            @if (Context.Session.GetString("Role") == "FleetManager" || Context.Session.GetString("Role") == "MaintenanceEngineer")
                            {
                                <a asp-action="UpdateServiceRecord" asp-route-id="@m.maintenanceId" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@m.maintenanceId" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">No maintenance records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>