@model IEnumerable<TransportationManagement.Models.MaintenanceRecord>
@{
    ViewData["Title"] = "Maintenance Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-wrench fa-lg px-1"></i>
        </div>
        <h3 class="mb-0 fw-bold">Maintenance Records</h3>
    </div>
    
    @if (Context.Session.GetString("Role") == "FleetManager")
    {
        <a asp-action="ScheduleMaintenance" class="btn btn-danger rounded-pill shadow-sm px-4">
            <i class="fas fa-plus me-2"></i>Schedule Maintenance
        </a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">S.NO</th>
                    <th class="py-3 border-0">Vehicle</th>
                    <th class="py-3 border-0">Service Type</th>
                    <th class="py-3 border-0">Service Date</th>
                    <th class="py-3 border-0">Remarks</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @{
                    int rowNum = 1;
                }
                @foreach (var item in Model)
                {
                    string badgeClass = item.remarks != null && item.remarks.Contains("[COMPLETED]") ? "bg-success" : "bg-warning text-dark";
                    string displayStatus = item.remarks != null && item.remarks.Contains("[COMPLETED]") ? "Completed" : "In Service";

                    <tr>
                        <td class="ps-4 py-3 text-muted">@(rowNum++)</td>
                        <td class="py-3 fw-semibold text-dark">@(item.Vehicle?.vehicleNumber ?? "Unknown")</td>
                        <td class="py-3">@item.serviceType</td>
                        <td class="py-3">@item.serviceDate.ToString("dd MMM yyyy")</td>
                        <td class="py-3 text-muted">@item.remarks</td>
                        <td class="py-3">
                            <span class="badge rounded-pill @badgeClass px-3 py-2">
                                @if (displayStatus == "In Service")
                                {
                                    <i class="fas fa-tools me-1"></i>
                                }
                                @displayStatus
                            </span>
                        </td>
                
                        <td class="text-end pe-4 py-3">
    
                            <a asp-action="GetMaintenanceDetails" asp-route-id="@item.maintenanceId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm me-1" title="View Details">
                                <i class="fas fa-eye"></i>
                            </a>
    
                            @if (Context.Session.GetString("Role") == "MaintenanceEngineer")
                            {
                                @if (displayStatus != "Completed")
                                {
                                    <form asp-action="CompleteMaintenance" asp-route-id="@item.maintenanceId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-light btn-sm text-success rounded-circle shadow-sm me-1" title="Complete Service" onclick="return confirm('Mark this maintenance as completed?');">
                                            <i class="fas fa-check"></i>
                                        </button>
                                    </form>

                                    <a asp-action="UpdateServiceRecord" asp-route-id="@item.maintenanceId" class="btn btn-light btn-sm text-warning rounded-circle shadow-sm me-1" title="Edit">
                                        <i class="fas fa-edit"></i>
                                    </a>
            
                                    <a asp-action="Delete" asp-route-id="@item.maintenanceId" class="btn btn-light btn-sm text-danger rounded-circle shadow-sm" title="Delete">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                }
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No maintenance records found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>