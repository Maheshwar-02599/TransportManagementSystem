@model TransportationManagement.Models.Vehicle
@{ ViewData["Title"] = "Vehicle Details"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-car me-2"></i>Vehicle Details</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Vehicle ID</dt><dd class="col-sm-9">@Model.vehicleId</dd>
        <dt class="col-sm-3">Vehicle Number</dt><dd class="col-sm-9">@Model.vehicleNumber</dd>
        <dt class="col-sm-3">Model</dt><dd class="col-sm-9">@Model.model</dd>
        <dt class="col-sm-3">Capacity</dt><dd class="col-sm-9">@Model.capacity</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @(Model.vehiclestatus==VehicleStatus.ACTIVE?"bg-success":Model.vehiclestatus==VehicleStatus.IN_SERVICE?"bg-warning text-dark":"bg-danger")">@Model.vehiclestatus</span></dd>
    </dl>
</div></div>
