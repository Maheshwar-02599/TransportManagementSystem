@model IEnumerable<TransportationManagement.Models.Vehicle>
@{ ViewData["Title"] = "Vehicles"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-car me-2"></i>Fleet Vehicles</h3>
    @if (Context.Session.GetString("Role") == "FleetManager") {
        <a asp-action="AddVehicle" class="btn btn-primary"><i class="fas fa-plus me-1"></i>Add Vehicle</a>
    }
</div>

@if (TempData["Error"] != null) {
    <div class="alert alert-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null) {
    <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>Vehicle Number</th><th>Model</th><th>Capacity</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
            @{ 
                int vRow = 1; 
                var busyFleet = ViewBag.BusyVehicleIds as List<int> ?? new List<int>();
            }
            @foreach(var veh in Model){
                
                    bool isOnRoute = busyFleet.Contains(veh.vehicleId);
                    string liveStatus = isOnRoute ? "ON_TRIP" : veh.vehiclestatus.ToString();
                    string liveBadge = isOnRoute ? "bg-warning text-dark" : (veh.vehiclestatus.ToString() == "ACTIVE" ? "bg-success" : "bg-danger");
                
            <tr>
                <td>@(vRow++)</td>
                <td><strong>@veh.vehicleNumber</strong></td>
                <td>@veh.model</td>
                <td>@veh.capacity</td>
                <td><span class="badge @liveBadge">@liveStatus</span></td>
                <td>
                    <a asp-action="GetVehicleDetails" asp-route-id="@veh.vehicleId" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                    
                    @if(Context.Session.GetString("Role") == "FleetManager"){
                        <a asp-action="UpdateVehicle" asp-route-id="@veh.vehicleId" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                        <a asp-action="Delete" asp-route-id="@veh.vehicleId" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
                    }
                </td>
            </tr>}
            @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-3">No vehicles found.</td></tr>}
            </tbody>
        </table>
    </div>
</div>