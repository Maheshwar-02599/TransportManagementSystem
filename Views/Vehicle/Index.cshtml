@model IEnumerable<TransportationManagement.Models.Vehicle>
@{ ViewData["Title"] = "Vehicles"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-car fa-lg px-1"></i>
        </div>
        <h3 class="mb-0 fw-bold">Fleet Vehicles</h3>
    </div>
    
    @if (Context.Session.GetString("Role") == "FleetManager") {
        <a asp-action="AddVehicle" class="btn btn-primary rounded-pill shadow-sm px-4"><i class="fas fa-plus me-2"></i>Add Vehicle</a>
    }
</div>

@if (TempData["Error"] != null) {
    <div class="alert alert-danger border-0 shadow-sm rounded-3 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null) {
    <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">#</th>
                    <th class="py-3 border-0">Vehicle Number</th>
                    <th class="py-3 border-0">Model</th>
                    <th class="py-3 border-0">Capacity</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
            @{ 
                int vRow = 1; 
                var busyFleet = ViewBag.BusyVehicleIds as List<int> ?? new List<int>();
            }
            @foreach(var veh in Model){
                
                    bool isOnRoute = busyFleet.Contains(veh.vehicleId);
                    string liveStatus = isOnRoute ? "ON_TRIP" : veh.vehiclestatus.ToString();
                    string liveBadge = isOnRoute ? "bg-warning text-dark" : (veh.vehiclestatus.ToString() == "ACTIVE" ? "bg-success" : "bg-danger");
                
            <tr>
                <td class="ps-4 py-3 text-muted">@(vRow++)</td>
                <td class="py-3 fw-semibold text-dark">@veh.vehicleNumber</td>
                <td class="py-3">@veh.model</td>
                <td class="py-3">@veh.capacity</td>
                <td class="py-3"><span class="badge rounded-pill @liveBadge px-3 py-2">@liveStatus</span></td>
                <td class="text-end pe-4 py-3">
                    <a asp-action="GetVehicleDetails" asp-route-id="@veh.vehicleId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm me-1" title="View Details"><i class="fas fa-eye"></i></a>
                    
                    @if(Context.Session.GetString("Role") == "FleetManager"){
                        <a asp-action="UpdateVehicle" asp-route-id="@veh.vehicleId" class="btn btn-light btn-sm text-warning rounded-circle shadow-sm me-1" title="Edit"><i class="fas fa-edit"></i></a>
                        <a asp-action="Delete" asp-route-id="@veh.vehicleId" class="btn btn-light btn-sm text-danger rounded-circle shadow-sm" title="Delete"><i class="fas fa-trash"></i></a>
                    }
                </td>
            </tr>
            }
            @if(!Model.Any()){<tr><td colspan="6" class="text-center text-muted py-5">No vehicles found.</td></tr>}
            </tbody>
        </table>
    </div>
</div>