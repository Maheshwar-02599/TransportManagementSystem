@model TransportationManagement.Models.Vehicle
@{
    ViewData["Title"] = "Update Vehicle";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-edit fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Update Vehicle</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <form asp-action="UpdateVehicle" method="post">
            <input type="hidden" asp-for="vehicleId" />
            
            <div class="row g-4 mb-3">
                <div class="col-md-6">
                    <label asp-for="vehicleNumber" class="form-label fw-semibold text-secondary small text-uppercase">Vehicle Number</label>
                    <input asp-for="vehicleNumber" class="form-control bg-light border-0 rounded-3 py-2" />
                    <span asp-validation-for="vehicleNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="model" class="form-label fw-semibold text-secondary small text-uppercase">Model</label>
                    <input asp-for="model" class="form-control bg-light border-0 rounded-3 py-2" />
                    <span asp-validation-for="model" class="text-danger small"></span>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="capacity" class="form-label fw-semibold text-secondary small text-uppercase">Capacity</label>
                    <input asp-for="capacity" type="number" class="form-control bg-light border-0 rounded-3 py-2" />
                    <span asp-validation-for="capacity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="vehiclestatus" class="form-label fw-semibold text-secondary small text-uppercase">Status</label>
                    <select asp-for="vehiclestatus" class="form-select bg-light border-0 rounded-3 py-2" asp-items="Html.GetEnumSelectList<VehicleStatus>()"></select>
                </div>
            </div>
            
            <div class="mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm"><i class="fas fa-save me-2"></i>Update Vehicle</button>
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>