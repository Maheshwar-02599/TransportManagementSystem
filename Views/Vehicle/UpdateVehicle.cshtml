@model TransportationManagement.Models.Vehicle
@{ ViewData["Title"] = "Update Vehicle"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-edit me-2"></i>Update Vehicle</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <form asp-action="UpdateVehicle" method="post">
        <input type="hidden" asp-for="vehicleId" />
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="vehicleNumber" class="form-label fw-semibold">Vehicle Number</label>
                <input asp-for="vehicleNumber" class="form-control" />
                <span asp-validation-for="vehicleNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="model" class="form-label fw-semibold">Model</label>
                <input asp-for="model" class="form-control" />
                <span asp-validation-for="model" class="text-danger small"></span>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="capacity" class="form-label fw-semibold">Capacity</label>
                <input asp-for="capacity" type="number" class="form-control" />
                <span asp-validation-for="capacity" class="text-danger small"></span>
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="vehiclestatus" class="form-label fw-semibold">Status</label>
                <select asp-for="vehiclestatus" class="form-select" asp-items="Html.GetEnumSelectList<VehicleStatus>()">
              
                </select>
            </div>
        </div>
        <button type="submit" class="btn btn-warning"><i class="fas fa-save me-1"></i>Update</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div>
