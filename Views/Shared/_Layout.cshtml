    </nav> *@
        <nav class="navbar navbar-expand-lg navbar-dark px-4">
            <div class="container-fluid">
 
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-truck-moving me-2"></i>Transport MS
                </a>
 
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
 
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="fas fa-chart-line me-1"></i>Dashboard
                                </a>
                            </li>
                        }
 
                        @if (role != "Driver")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Vehicle" asp-action="Index">
                                    <i class="fas fa-car me-1"></i>Vehicles
                                </a>
                            </li>
     
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Driver" asp-action="Index">
                                    <i class="fas fa-id-card me-1"></i>Drivers
                                </a>
                            </li>
     
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trip" asp-action="Index">
                                    <i class="fas fa-route me-1"></i>Trips
                                </a>
                            </li>
     
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Maintenance" asp-action="Index">
