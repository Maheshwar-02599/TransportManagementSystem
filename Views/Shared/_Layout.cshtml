<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Transport MS</title>
 
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
 
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet">
 
    <style>
            body {
                background-color: #f4f7f6;
                font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
                color: #2b3445;
            }

            /* --- Navbar Styling --- */
            .navbar {
                background-color: #ffffff !important;
                box-shadow: 0 2px 15px rgba(0,0,0,0.04);
                padding: 12px 0;
            }

            .navbar-brand {
                color: #2b3445 !important;
                font-size: 1.25rem;
                letter-spacing: -0.5px;
            }

                .navbar-brand i {
                    color: #0d6efd;
                }

            .nav-link {
                color: #6b7280 !important;
                font-weight: 500;
                padding: 8px 16px !important;
                border-radius: 8px;
                transition: all 0.2s ease;
                margin: 0 4px;
            }

                .nav-link:hover, .nav-link:focus {
                    color: #0d6efd !important;
                    background-color: rgba(13, 110, 253, 0.08);
                }

                .nav-link i {
                    opacity: 0.7;
                    margin-right: 6px;
                }

                .nav-link:hover i {
                    opacity: 1;
                }

            .user-badge {
                background-color: #f8f9fa;
                border: 1px solid #e9ecef;
                color: #495057;
                border-radius: 50rem;
                padding: 6px 16px;
                font-weight: 600;
                font-size: 0.875rem;
            }

                .user-badge i {
                    color: #0d6efd;
                    margin-right: 6px;
                }

            .btn-logout {
                color: #dc3545;
                background-color: rgba(220, 53, 69, 0.1);
                border: none;
                border-radius: 50rem;
                padding: 6px 16px;
                font-weight: 600;
                transition: all 0.2s;
            }

                .btn-logout:hover {
                    background-color: #dc3545;
                    color: white;
                }

            /* --- Global Helpers --- */
            .transition-hover {
                transition: transform 0.2s ease, box-shadow 0.2s ease;
            }
        
                .transition-hover:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 10px 20px rgba(0,0,0,0.08) !important;
                }
        
            .tracking-wide {
                letter-spacing: 0.5px;
            }
    </style>
</head>
<body>

    @if (Context.Session.GetString("Username") != null)
    {
        string role = Context.Session.GetString("Role") ?? "";
        <nav class="navbar navbar-expand-lg sticky-top px-4 mb-4">
            <div class="container-fluid">
            
                <a class="navbar-brand fw-bold me-4" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-truck-moving fa-lg me-2"></i>Transport MS
                </a>
            
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (role == "Admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt"></i>Dashboard
                                </a>
                            </li>
                        }
 
                        @if (role == "Admin" || role == "FleetManager")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Vehicle" asp-action="Index">
                                    <i class="fas fa-car"></i>Vehicles
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Driver" asp-action="Index">
                                    <i class="fas fa-id-card"></i>Drivers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trip" asp-action="Index">
                                    <i class="fas fa-route"></i>Trips
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Maintenance" asp-action="Index">
                                    <i class="fas fa-wrench"></i>Maintenance
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Fuel" asp-action="Index">
                                    <i class="fas fa-gas-pump"></i>Fuel
                                </a>
                            </li>
                        }
                        else if (role == "MaintenanceEngineer")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Maintenance" asp-action="Index">
                                    <i class="fas fa-wrench"></i>Maintenance
                                </a>
                            </li>
                        }
                        else if (role == "Driver")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Trip" asp-action="Index">
                                    <i class="fas fa-route"></i>Trips
                                </a>
                            </li>
                        }
                    </ul>
 
                    <div class="d-flex align-items-center mt-3 mt-lg-0">
                        <div class="user-badge me-3 shadow-sm">
                            <i class="fas fa-user-circle"></i> @Context.Session.GetString("Username")
                        </div>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="btn btn-logout shadow-sm">
                                <i class="fas fa-sign-out-alt me-1"></i> Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </nav>
    }

    <div class="container-fluid px-lg-5 pb-2">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>