@model TransportationManagement.ViewModels.LoginViewModel
@{
    Layout = null; ViewData["Title"] = "Secure Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Transport MS</title>
    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    
    <style>
            body, html {
                height: 100%;
                margin: 0;
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #ffffff;
                overflow-x: hidden;
            }

            /* --- Left Branding Side --- */
            .brand-side {
                background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
                color: white;
                position: relative;
                overflow: hidden;
            }

            /* Glowing Background Orbs */
            .brand-glow-1 {
                position: absolute;
                width: 800px;
                height: 800px;
                background: radial-gradient(circle, rgba(56, 189, 248, 0.08) 0%, rgba(0,0,0,0) 70%);
                top: -200px;
                left: -200px;
                border-radius: 50%;
            }

            .brand-glow-2 {
                position: absolute;
                width: 600px;
                height: 600px;
                background: radial-gradient(circle, rgba(99, 102, 241, 0.08) 0%, rgba(0,0,0,0) 70%);
                bottom: -100px;
                right: -100px;
                border-radius: 50%;
            }

            .animated-graphic {
                position: relative;
                height: 120px;
                margin-bottom: 2.5rem;
                z-index: 2;
                transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            }
        
                .animated-graphic:hover {
                    transform: translateX(15px) translateY(-5px);
                }

            .truck-icon {
                font-size: 4.5rem;
                color: #38bdf8;
                filter: drop-shadow(0 15px 25px rgba(56, 189, 248, 0.4));
            }

            /* Glassmorphic Badge */
            .glass-badge {
                background: rgba(255, 255, 255, 0.05);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.1);
                padding: 8px 20px;
                border-radius: 50rem;
                font-size: 0.85rem;
                font-weight: 600;
                color: #cbd5e1;
                display: inline-flex;
                align-items: center;
                margin-bottom: 2rem;
                z-index: 2;
                width: max-content;
                box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            }

            /* --- Right Form Side --- */
            .form-side-container {
                width: 100%;
                max-width: 440px;
                margin: 0 auto;
            }

            /* Premium Form Elements */
            .form-floating > .form-control {
                border-radius: 14px;
                border: 2px solid #f1f5f9;
                background-color: #f8fafc;
                font-weight: 500;
                color: #1e293b;
                transition: all 0.3s ease;
                height: calc(3.5rem + 10px);
            }

                .form-floating > .form-control:focus {
                    border-color: #3b82f6;
                    box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.15);
                    background-color: #ffffff;
                }

            .form-floating > label {
                color: #64748b;
                font-weight: 500;
                padding-left: 1.2rem;
            }

            /* The Premium Button */
            .btn-login {
                background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
                border: none;
                border-radius: 14px;
                padding: 16px;
                font-weight: 700;
                font-size: 1.1rem;
                letter-spacing: 0.5px;
                color: white;
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                box-shadow: 0 10px 20px rgba(37, 99, 235, 0.25);
            }

                .btn-login:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 15px 30px rgba(37, 99, 235, 0.35);
                    color: white;
                }
    </style>
</head>
<body>

    <div class="container-fluid p-0">
        <div class="row g-0 min-vh-100">
            
            <div class="col-lg-7 d-none d-lg-flex brand-side flex-column justify-content-center p-5">
                <div class="brand-glow-1"></div>
                <div class="brand-glow-2"></div>
                
                <div style="z-index: 2; padding-left: 5%;">
                    <div class="glass-badge">
                        <i class="fas fa-shield-check text-info me-2"></i> Secure Enterprise Portal
                    </div>
                    
                    <div class="animated-graphic">
                        <i class="fas fa-truck-moving truck-icon"></i>
                    </div>
                    
                    <h1 class="display-4 fw-bolder mb-3" style="letter-spacing: -1px;">
                        Smart Fleet<br />
                        <span style="color: #38bdf8;">Operations.</span>
                    </h1>
                    <p class="fs-5 text-light opacity-75" style="max-width: 480px; line-height: 1.6;">
                        Streamline your logistics, monitor vehicles in real-time, and manage your workforce with our next-generation platform.
                    </p>
                    
                    <div class="mt-5">
                        <div class="d-flex align-items-center opacity-75">
                            <span class="rounded-circle bg-success me-3" style="width: 12px; height: 12px; box-shadow: 0 0 10px #198754;"></span>
                            <small class="fw-medium font-monospace" style="letter-spacing: 2px;">SYSTEM ONLINE & OPERATIONAL</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center bg-white p-4 shadow-lg" style="z-index: 5;">
                <div class="form-side-container">
                    
                    <div class="text-center mb-5 d-lg-none">
                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                            <i class="fas fa-truck-moving fa-2x"></i>
                        </div>
                        <h3 class="fw-bold text-dark">Transport MS</h3>
                    </div>

                    <div class="mb-5">
                        <h2 class="fw-bolder text-dark mb-2" style="letter-spacing: -0.5px;">Welcome back</h2>
                        <p class="text-muted fs-6">Please enter your credentials to access the system.</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 rounded-3 border-0 small fw-bold mb-4 bg-danger bg-opacity-10 text-danger"></div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Username" class="form-control px-4" id="floatingInput" placeholder="name@example.com" />
                            <label asp-for="Username"><i class="fas fa-envelope me-2 text-muted"></i>Email Address</label>
                            <span asp-validation-for="Username" class="text-danger small mt-1 d-block fw-semibold ps-2"></span>
                        </div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Password" type="password" class="form-control px-4" id="floatingPassword" placeholder="Password" />
                            <label asp-for="Password"><i class="fas fa-lock me-2 text-muted"></i>Password</label>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block fw-semibold ps-2"></span>
                        </div>
                        
                        @* <div class="d-flex justify-content-between align-items-center mb-5 px-1">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted small fw-medium" for="rememberMe">Remember me</label>
                            </div>
                            <a href="#" class="text-primary small fw-bold text-decoration-none">Forgot password?</a>
                        </div> *@
                        
                        <button type="submit" class="btn btn-login w-100 d-flex justify-content-center align-items-center gap-2">
                            Secure Sign In <i class="fas fa-arrow-right ms-1"></i>
                        </button>
                    </form>
                    
                    @* <div class="text-center mt-5 pt-4 border-top">
                        <p class="text-muted small mb-3">Don't have an account? <a asp-action="Register" class="text-primary fw-bold text-decoration-none ms-1">Create an account</a></p> *@
                        
                        @* <div class="d-inline-flex align-items-center bg-light rounded-pill px-4 py-2 border border-light shadow-sm mt-2">
                            <i class="fas fa-info-circle text-muted me-2"></i>
                            <small class="text-muted font-monospace fw-medium">admin@transport.com / Admin@123</small>
                        </div> *@
                    </div>

                </div>
            </div>
        </div>
    

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>