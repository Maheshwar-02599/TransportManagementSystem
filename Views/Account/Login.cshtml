@model TransportationManagement.ViewModels.LoginViewModel
@{ Layout = null; ViewData["Title"] = "Login"; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Transportation Management</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-light">
<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0"><i class="fas fa-truck-moving me-2"></i>Transportation Management</h4>
                    <small>Smart Fleet Operational System</small>
                </div>
                <div class="card-body p-4">
                    <h5 class="card-title text-center mb-4">Sign In</h5>
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-semibold">Email Address</label>
                            <input asp-for="Username" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-semibold">Password</label>
                            <input asp-for="Password" class="form-control" placeholder="Enter your password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark"><i class="fas fa-sign-in-alt me-2"></i>Login</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer text-center py-3">
                    <small>Don't have an account? <a asp-action="Register">Register here</a></small>
                </div>
            </div>
            <div class="text-center mt-3">
                <small class="text-muted">Default Admin: admin@transport.com / Admin@123</small>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
