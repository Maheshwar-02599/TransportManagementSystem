@model TransportationManagement.Models.Trip
@{ ViewData["Title"] = "Trip Plan"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-route me-2"></i>Trip Plan Details</h3>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left me-1"></i>Back</a>
</div>
<div class="card"><div class="card-body">
    <dl class="row">
        <dt class="col-sm-3">Trip ID</dt><dd class="col-sm-9">@Model.tripId</dd>
        <dt class="col-sm-3">Vehicle</dt><dd class="col-sm-9">@(Model.Vehicle?.vehicleNumber??"-")</dd>
        <dt class="col-sm-3">Driver</dt><dd class="col-sm-9">@(Model.Driver?.name??"-")</dd>
        <dt class="col-sm-3">Origin</dt><dd class="col-sm-9">@Model.origin</dd>
        <dt class="col-sm-3">Destination</dt><dd class="col-sm-9">@Model.destination</dd>
        <dt class="col-sm-3">Planned Route</dt><dd class="col-sm-9">@(Model.plannedRoute??"Not specified")</dd>
        <dt class="col-sm-3">Status</dt><dd class="col-sm-9"><span class="badge @(Model.tripStatus==TripStatus.COMPLETED?"bg-success":Model.tripStatus==TripStatus.IN_PROGRESS?"bg-warning text-dark":"bg-info")">@Model.tripStatus</span></dd>
    </dl>
</div></div>
