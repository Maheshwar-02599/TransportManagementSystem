@model TransportationManagement.Models.Trip
@{
    ViewData["Title"] = "Update Trip Status";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-edit fa-lg px-1"></i>
        </div>
        <h3 class="fw-bold mb-0">Update Trip</h3>
    </div>
    <a asp-action="Index" class="btn btn-light shadow-sm rounded-pill px-3"><i class="fas fa-arrow-left me-2"></i>Back</a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-5">
        <form asp-action="UpdateTripStatus" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 rounded-3 border-0"></div>
            
            <input type="hidden" asp-for="tripId" />
            
            <div class="row g-4 mb-3">
                <div class="col-md-6">
                    <label asp-for="vehicleId" class="form-label fw-semibold text-secondary small text-uppercase">Vehicle</label>
                    <select asp-for="vehicleId" asp-items="ViewBag.Vehicles" class="form-select bg-light border-0 rounded-3 py-2"></select>
                    <span asp-validation-for="vehicleId" class="text-danger small fw-bold mt-1 d-block"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="driverId" class="form-label fw-semibold text-secondary small text-uppercase">Driver</label>
                    <select asp-for="driverId" asp-items="ViewBag.Drivers" class="form-select bg-light border-0 rounded-3 py-2"></select>
                </div>
            </div>
            
            <div class="row g-4 mb-3">
                <div class="col-md-6">
                    <label asp-for="origin" class="form-label fw-semibold text-secondary small text-uppercase">Origin</label>
                    <input asp-for="origin" class="form-control bg-light border-0 rounded-3 py-2" />
                </div>
                <div class="col-md-6">
                    <label asp-for="destination" class="form-label fw-semibold text-secondary small text-uppercase">Destination</label>
                    <input asp-for="destination" class="form-control bg-light border-0 rounded-3 py-2" />
                </div>
            </div>
            
            <div class="mb-4">
                <label asp-for="plannedRoute" class="form-label fw-semibold text-secondary small text-uppercase">Planned Route</label>
                <textarea asp-for="plannedRoute" class="form-control bg-light border-0 rounded-3 py-2" rows="3"></textarea>
            </div>
            
            <div class="col-md-4 mb-4">
                <label asp-for="tripStatus" class="form-label fw-semibold text-secondary small text-uppercase">Trip Status</label>
                <select asp-for="tripStatus" class="form-select bg-light border-0 rounded-3 py-2" asp-items="Html.GetEnumSelectList<TripStatus>()"></select>
            </div>
            
            <div class="mt-5 pt-3 border-top">
                <button type="submit" class="btn btn-warning rounded-pill px-4 shadow-sm"><i class="fas fa-save me-2"></i>Update Trip</button>
                <a asp-action="Index" class="btn btn-link text-muted text-decoration-none ms-3">Cancel</a>
            </div>
        </form>
    </div>
</div>