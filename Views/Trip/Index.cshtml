@model IEnumerable<TransportationManagement.Models.Trip>
@{
    ViewData["Title"] = "Trips";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="d-flex align-items-center">
        <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-2 me-3 shadow-sm">
            <i class="fas fa-route fa-lg px-1"></i>
        </div>
        <h3 class="mb-0 fw-bold">Trip Scheduling</h3>
    </div>
    
    @if (Context.Session.GetString("Role") == "FleetManager")
    {
        <a asp-action="CreateTrip" class="btn btn-warning rounded-pill shadow-sm px-4"><i class="fas fa-plus me-2"></i>New Trip</a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm rounded-3 fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 shadow-sm rounded-3"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-secondary small text-uppercase tracking-wide">
                <tr>
                    <th class="ps-4 py-3 border-0">#</th>
                    <th class="py-3 border-0">Origin</th>
                    <th class="py-3 border-0">Destination</th>
                    <th class="py-3 border-0">Vehicle</th>
                    <th class="py-3 border-0">Driver</th>
                    <th class="py-3 border-0">Status</th>
                    <th class="text-end pe-4 py-3 border-0">Actions</th>
                </tr>
            </thead>
            <tbody class="border-top-0">
                @{
                    int i = 1;
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td class="ps-4 py-3 text-muted">@(i++)</td>
                        <td class="py-3 fw-semibold text-dark">@t.origin</td>
                        <td class="py-3 fw-semibold text-dark">@t.destination</td>
                        <td class="py-3 font-monospace">@(t.Vehicle?.vehicleNumber ?? "-")</td>
                        <td class="py-3">@(t.Driver?.name ?? "-")</td>
                        <td class="py-3">
                            <span class="badge rounded-pill @(t.tripStatus == TripStatus.COMPLETED ? "bg-success" : t.tripStatus == TripStatus.IN_PROGRESS ? "bg-warning text-dark" : "bg-info") px-3 py-2">
                                @t.tripStatus
                            </span>
                        </td>
                        <td class="text-end pe-4 py-3">
                            @if (Context.Session.GetString("Role") == "Driver")
                            {
                                @if (t.tripStatus.ToString() == "PLANNED")
                                {
                                    <form asp-action="StartTrip" asp-route-id="@t.tripId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm rounded-pill shadow-sm px-3 me-1"><i class="fas fa-play me-1"></i>Start</button>
                                    </form>
                                }
                                else if (t.tripStatus.ToString() == "IN_PROGRESS")
                                {
                                    <button type="button" class="btn btn-danger btn-sm rounded-pill shadow-sm px-3 me-1" data-bs-toggle="modal" data-bs-target="#endTripModalMain-@t.tripId">
                                        <i class="fas fa-stop me-1"></i>End
                                    </button>

                                    <div class="modal fade text-start" id="endTripModalMain-@t.tripId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content border-0 shadow-lg rounded-4">
                                                <div class="modal-header border-0 bg-light rounded-top-4 pb-0 pt-4 px-4">
                                                    <h5 class="modal-title fw-bold text-dark"><i class="fas fa-flag-checkered text-success me-2"></i>Complete Trip #@t.tripId</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="EndTrip" method="post">
                                                    <div class="modal-body p-4">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@t.tripId" />
                                                        
                                                        <p class="text-muted mb-4">Please enter the total distance traveled. The system will automatically update the vehicle's odometer and log the fuel consumption.</p>
                                                        
                                                        <div class="form-floating mb-3">
                                                            <input type="number" name="distanceTraveled" class="form-control bg-light border-0 rounded-3 fw-bold text-primary" id="distMain-@t.tripId" placeholder="Distance in km" required min="1" />
                                                            <label for="distMain-@t.tripId"><i class="fas fa-road me-2 text-muted"></i>Distance Traveled (km)</label>
                                                        </div>
                                                        
                                                        <div class="alert alert-info bg-info bg-opacity-10 border-0 rounded-3 small mb-0 fw-medium">
                                                            <i class="fas fa-magic me-2 text-info"></i> Auto-calculating fuel at 10 km/L (Rs. 100/L).
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0 pb-4 px-4 justify-content-between">
                                                        <button type="button" class="btn btn-light rounded-pill px-4 fw-medium" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-success rounded-pill px-4 shadow-sm fw-bold"><i class="fas fa-check-circle me-2"></i>Confirm & End</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        
                            <a asp-action="GetTripPlan" asp-route-id="@t.tripId" class="btn btn-light btn-sm text-info rounded-circle shadow-sm me-1" title="View"><i class="fas fa-eye"></i></a>
    
                            @if (Context.Session.GetString("Role") == "FleetManager")
                            {
                                <a asp-action="UpdateTripStatus" asp-route-id="@t.tripId" class="btn btn-light btn-sm text-warning rounded-circle shadow-sm me-1" title="Edit"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@t.tripId" class="btn btn-light btn-sm text-danger rounded-circle shadow-sm" title="Delete"><i class="fas fa-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-5">No trips found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>