@model IEnumerable<TransportationManagement.Models.Trip>
@{
    ViewData["Title"] = "Trips";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3><i class="fas fa-route me-2"></i>Trip Scheduling</h3>
    
    @if (Context.Session.GetString("Role") == "FleetManager")
    {
        <a asp-action="CreateTrip" class="btn btn-warning"><i class="fas fa-plus me-1"></i>New Trip</a>
    }
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>#</th><th>Origin</th><th>Destination</th><th>Vehicle</th><th>Driver</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @{
                    int i = 1;
                }
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@(i++)</td>
                        <td>@t.origin</td>
                        <td>@t.destination</td>
                        <td>@(t.Vehicle?.vehicleNumber ?? "-")</td>
                        <td>@(t.Driver?.name ?? "-")</td>
                        <td>
                            <span class="badge @(t.tripStatus == TripStatus.COMPLETED ? "bg-success" : t.tripStatus == TripStatus.IN_PROGRESS ? "bg-warning text-dark" : "bg-info")">
                                @t.tripStatus
                            </span>
                        </td>
                        <td>
                            <a asp-action="GetTripPlan" asp-route-id="@t.tripId" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
    
                            @if (Context.Session.GetString("Role") == "FleetManager")
                            {
                                <a asp-action="UpdateTripStatus" asp-route-id="@t.tripId" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                                <a asp-action="Delete" asp-route-id="@t.tripId" class="btn btn-danger btn-sm"><i class="fas fa-trash"></i></a>
                            }

                            @if (Context.Session.GetString("Role") == "Driver")
                            {
                                @if (t.tripStatus.ToString() == "PLANNED")
                                {
                                    <form asp-action="StartTrip" asp-route-id="@t.tripId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-play me-1"></i>Start</button>
                                    </form>
                                }
                                else if (t.tripStatus.ToString() == "IN_PROGRESS")
                                {
                                    <form asp-action="EndTrip" asp-route-id="@t.tripId" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fas fa-stop me-1"></i>End</button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-3">No trips found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>